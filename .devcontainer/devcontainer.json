{
  "name": "Twin PC",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "forwardPorts": [
    3001
  ],
  "portsAttributes": {
    "3001": {
      "label": "Twin PC Desktop",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "postCreateCommand": "mkdir -p \"$HOME/twin-pc-data\""
}